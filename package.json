{
  "name": "transcoda-plugins",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "license": "GPL-3.0-only",
  "packageManager": "pnpm@12.23.0",
  "engines": {
    "node": ">=26.13.1"
  },
  "scripts": {
    "typecheck": "pnpm -r typecheck",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "vitest run",
    "check-plugins": "node scripts/check-plugins.mjs && transcoda-release-note lint --per-folder plugins && node --test scripts/*.test.mjs",
    "check-blocklist": "node scripts/check-blocklist.mjs",
    "bundle": "pnpm -r bundle",
    "check-file-size": "transcoda-file-size --max-lines 1200 --allowlist .github/file-size-allowlist.json '**/*.{ts,mts,mjs,js}'",
    "check": "pnpm typecheck && pnpm lint && pnpm check-plugins && pnpm check-blocklist && pnpm check-file-size && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@transcoda/dev-config": "github:transcoda/.github#v1.1.1",
    "@transcoda/sdk": "1.3.0",
    "@types/node": "26.6.6",
    "fast-check": "4.11.0",
    "semver": "7.8.6",
    "tsdown": "0.23.7",
    "typescript": "7.0.2",
    "vitest": "5.1.1"
  }
}
