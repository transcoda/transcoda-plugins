{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended", ":pinAllExceptPeerDependencies", ":semanticCommits"],
  "enabledManagers": ["npm", "nodenv", "github-actions"],
  "minimumReleaseAge": "3 days",
  "minimumReleaseAgeBehaviour": "timestamp-optional",
  "internalChecksFilter": "strict",
  "rangeStrategy": "pin",
  "labels": ["dependencies", "no user-facing change"],
  "reviewers": ["jhadenfeldt"],
  "semanticCommitType": "Dependencies",
  "semanticCommitScope": null,
  "prBodyTemplate": "{{{header}}}{{{table}}}{{{warnings}}}{{{notes}}}{{{changelogs}}}{{{controls}}}",
  "packageRules": [
    {
      "description": "House-style titles: config:recommended sets chore/fix per package, so override it here; later rules set CI and FFmpeg.",
      "matchPackageNames": ["*"],
      "semanticCommitType": "Dependencies"
    },
    {
      "description": "SHA-pinned actions in one PR; Renovate rewrites the SHA and the version comment.",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "semanticCommitType": "CI",
      "addLabels": ["github_actions"]
    },
    {
      "description": "Repository and plugin dev dependencies (plugins ship no runtime dependencies): minor and patch in one PR, majors one by one.",
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["minor", "patch"],
      "groupName": "npm non-major"
    },
    {
      "matchManagers": ["npm"],
      "matchUpdateTypes": ["major"]
    },
    {
      "description": "Our own SDK is published from transcoda/transcoda's CI with provenance: no release-age wait (as in pnpm's minimumReleaseAgeExclude).",
      "matchPackageNames": ["@transcoda/sdk"],
      "minimumReleaseAge": null
    },
    {
      "description": "Node.js: .node-version, engines and @types/node move together on the LTS line CI runs; majors by hand.",
      "matchPackageNames": ["node", "@types/node"],
      "groupName": "Node.js"
    },
    {
      "matchPackageNames": ["node", "@types/node"],
      "matchUpdateTypes": ["major"],
      "enabled": false
    }
  ]
}
